<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/payday_auth_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/payday_primary">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="16dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuButton"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/white"
                android:textSize="22sp" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="104dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_auth_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/current_month"
                    android:textColor="@color/payday_text_primary"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_auth_card"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/monthly_total" android:textColor="@color/payday_text_hint" android:textSize="12sp" />
                        <TextView android:id="@+id/totalExpense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="₩0" android:textColor="@color/payday_primary" android:textSize="24sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/recurring_total" android:textColor="@color/payday_text_hint" android:textSize="12sp" />
                        <TextView android:id="@+id/recurringExpense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="₩0" android:textColor="@color/payday_text_primary" android:textSize="24sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_auth_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_distribution" android:textColor="@color/payday_text_primary" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/current_month_basis" android:textColor="@color/payday_text_secondary" android:textSize="12sp" />
                    <TextView android:layout_width="160dp" android:layout_height="160dp" android:layout_marginTop="16dp" android:background="@drawable/bg_dashboard_chart" android:gravity="center" android:text="@string/chart_placeholder" android:textColor="@color/payday_primary" android:textSize="24sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/emptyDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_auth_card"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/dashboard_empty"
                    android:textColor="@color/payday_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/white"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/dashboard_tab"
                android:textColor="@color/payday_primary"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/listTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/lists_tab"
                android:textColor="@color/payday_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/logoutButton"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_auth_card"
        android:elevation="8dp"
        android:gravity="center"
        android:text="@string/logout"
        android:textColor="@color/payday_text_primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/addExpenseButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_dashboard_fab"
        android:elevation="8dp"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="32sp" />
</FrameLayout>
